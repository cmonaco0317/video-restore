{
  "manifest_version": 3,
  "name": "Video Upscaler",
  "version": "1.0.0",
  "description": "GPU upscaling (Lanczos-3) + adaptive sharpening for any video on the page. Survives screenshare, AirPlay mirroring and HDMI.",

  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],

  "optional_host_permissions": ["*://*/*"],

  "options_ui": { "page": "options.html", "open_in_tab": true },

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "Upscale video on this page (Cmd+Shift+U)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "toggle": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Toggle the upscaler on this tab"
    }
  }
}
